<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>{{ clickhouse_max_memory_usage | default('10000000000') }}</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
            <max_threads>{{ clickhouse_max_threads | default('16') }}</max_threads>
        </default>

        {% if clickhouse_profiles is defined %}
        {% for profile_name, profile_data in clickhouse_profiles.items() %}
        {% if profile_name != 'default' %}
        <{{ profile_name }}>
            {% for k, v in profile_data.items() %}
            <{{ k }}>{{ v }}</{{ k }}>
            {% endfor %}
        </{{ profile_name }}>
        {% endif %}
        {% endfor %}
        {% endif %}
    </profiles>
</clickhouse>
